# ==============================================================================
# NGL English Assistant - Environment Configuration Template
# ==============================================================================
# Copia este archivo como '.env' y completa tus valores reales.
# NUNCA subas tu archivo '.env' a repositorios públicos de Git.

# Clave de API de Google Gemini (Obtén tu clave gratuita en: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Puerto de depuración remota de Chromium (Por defecto: 9222)
CHROME_DEBUGGING_PORT=9222

# Navegador preferido opcional: brave, opera, operagx, edge, chrome (Por defecto: auto-detectar)
# BROWSER=brave

